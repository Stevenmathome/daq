(kicad_sch (version 20250114) (generator "eeschema") (generator_version "9.0") (uuid "c0b0dae8-f7ea-40d2-adf6-c037b9ea2080") (paper "B") (title_block (title "DAQ Rev B - Assembly and mounting notes") (date "2026-11-22") (rev "B") (company "Steven Mendelsohn - Red Bull Futurist") (comment 1 "DAQ Rev B: Teensy 4.1 data acquisition / 7-valve controller board") (comment 2 "Designer: Steven Mendelsohn (Red Bull Futurist)") (comment 3 "2-layer 1.6 mm FR-4, 1 oz Cu, 142.5 x 138.0 mm, JLCPCB turnkey assembly") (comment 4 "Drawing set: sheets 1-8 (sheet 1 = schematic)")) (lib_symbols)
(text "ASSEMBLY, BRING-UP AND MOUNTING NOTES" (exclude_from_sim no) (at 14.000 17.000 0) (effects (font (size 3.0 3.0) bold) (justify left bottom)) (uuid "27f2d1c6-ae91-4b9b-b76e-e0dc63ebd2c8"))
(text "Boards ordered as JLCPCB turnkey (SMT + THT terminals); Teensy and its headers are hand-fitted." (exclude_from_sim no) (at 14.000 21.500 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "7a00b9f1-cb4c-42a0-bb1a-0026b7bd27be"))
(polyline (pts (xy 14.000 23.000) (xy 418.000 23.000)) (stroke (width 0.3) (type solid)) (fill (type none)) (uuid "c8c9d623-698e-44ce-af28-e4afce329d3b"))
(text "1. TEENSY 4.1 (U1) - HAND SOLDER" (exclude_from_sim no) (at 14.000 28.000 0) (effects (font (size 2.4 2.4) bold) (justify left bottom)) (uuid "cdac62d6-4b10-42bc-b125-69b0f246b8e5"))
(text "Solder two 1x24 female headers (HC-PM254-8.5H-1x24PZ, C41376163) into the U1 footprint, then plug the Teensy in." (exclude_from_sim no) (at 20.000 32.500 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "cc5605d9-20e8-403a-85f8-6ac9cf2f6ab1"))
(text "CUT the VIN-VUSB pad on the underside of the Teensy (near the USB connector) with a knife: the board feeds Teensy VIN from the 5 V buck through D9." (exclude_from_sim no) (at 20.000 36.700 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "1fd6498b-b79d-4d36-a641-b5e5146423ff"))
(text "After this cut, USB alone will not power the Teensy or let you program it. Apply 12 V (fuse fitted) to power the board; D9 stops the 5 V rail feeding back into the USB port." (exclude_from_sim no) (at 20.000 40.900 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "1b04c7b2-149a-46f6-b1a0-7249ab3812eb"))
(text "No battery is fitted (VBAT unconnected). Programming button/ON-OFF pads are not wired." (exclude_from_sim no) (at 20.000 45.100 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "e45d97fa-dd1e-4411-b83e-d67fa77d4e0b"))
(text "2. HX711 RATE JUMPERS (SJ1-SJ3)" (exclude_from_sim no) (at 14.000 52.300 0) (effects (font (size 2.4 2.4) bold) (justify left bottom)) (uuid "2d10bef8-f063-4c7a-97c3-b864288ce958"))
(text "Each HX711 RATE pin goes to the centre pad of a 3-way solder jumper: default bridge 1-2 = +3V3 = 80 SPS." (exclude_from_sim no) (at 20.000 56.800 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "11878427-53d5-464d-ac1c-6a47c853ef7a"))
(text "To run 10 SPS: cut the 1-2 bridge with a knife and bridge 2-3 (GND). RATE high is referenced to DVDD = 3.3 V." (exclude_from_sim no) (at 20.000 61.000 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "565bc03e-a952-49e3-86e3-5916ffe5ab60"))
(text "Firmware: read all three HX711 DOUT lines together on the shared SCK (pins 3, 0, 1 and clock pin 2)." (exclude_from_sim no) (at 20.000 65.200 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "2e32e4a3-10f9-4f04-9755-f9e9fe9327f3"))
(text "3. E-STOP WIRING (J32) AND FIRST POWER-UP" (exclude_from_sim no) (at 14.000 72.400 0) (effects (font (size 2.4 2.4) bold) (justify left bottom)) (uuid "efdbb51f-10d0-4351-b6c2-0e33563a2481"))
(text "J32 is the 4-pin terminal on the front / bottom edge. Silk: CUT = pins 1-2 (hardware valve-rail cut), SENSE = pins 3-4 (Teensy pin 10)." (exclude_from_sim no) (at 20.000 76.900 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "347437f0-434f-4059-8949-4455e9018e72"))
(text "Wire the E-stop NC contact block(s): contact A to pins 1-2, contact B to pins 3-4 (sheet 4). If no E-stop is fitted yet, jumper pins 1-2 or the valves stay off." (exclude_from_sim no) (at 20.000 81.100 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "c1c8d912-5309-4faa-8cd1-9a650326a80e"))
(text "First power-up: VIN-VUSB cut, 20 A fuse in F1, J32 1-2 jumpered or E-stop closed, 12 V on J16 with + on pin 1 (silk +). USB alone will not start the board." (exclude_from_sim no) (at 20.000 85.300 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "5f9c6984-a094-4ebe-9490-637b886f461f"))
(text "Power up with no valves attached: measure +5 V (C1) and +3V3, check the Teensy enumerates and ESTOP_IN reads HIGH with E-stop closed." (exclude_from_sim no) (at 20.000 89.500 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "f14c1a84-344b-457e-b5d1-1345290898e9"))
(text "Press E-stop: +12V_VALVE must drop to 0 V while +5 V / +3V3 / Teensy stay on; ESTOP_IN reads LOW. Release (reset) and valves re-arm automatically: add a firmware latch." (exclude_from_sim no) (at 20.000 93.700 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "d04ee8aa-db56-4fe2-9e05-8652246c522b"))
(text "With a bench supply set to 12 V / 1 A first, then a 15 A supply with valves on." (exclude_from_sim no) (at 20.000 97.900 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "a521e0e3-05b9-4c83-b0cd-c3290752c032"))
(text "4. 12 V INPUT" (exclude_from_sim no) (at 14.000 105.100 0) (effects (font (size 2.4 2.4) bold) (justify left bottom)) (uuid "e15cf1ee-5784-4d8a-b170-3f0be0c24e63"))
(text "Use >= 14 AWG for the supply lead. F1 is a Littelfuse 178.6165 ATO/ATC holder at the front edge (below J16)." (exclude_from_sim no) (at 20.000 109.600 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "009cc981-ca53-4ad4-8090-8d982e8409fa"))
(text "The 20 A ATO blade fuse is user supplied and is not in the BOM or the JLCPCB shipment." (exclude_from_sim no) (at 20.000 113.800 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "53c2b6ca-4fa3-4e91-a0ed-a94c8e9d4815"))
(text "If the fuse blows, find the fault, then pull the fuse straight out from the front edge (board on standoffs)" (exclude_from_sim no) (at 20.000 118.000 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "fef27093-6e64-44fb-9a0c-2fa679230b42"))
(text "and fit a new 20 A ATO/ATC automotive blade fuse (standard regular size, typically yellow)." (exclude_from_sim no) (at 20.000 122.200 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "feefb859-76a2-4051-aba2-3ff094e79ddd"))
(text "J16 silk is 12V IN, with + on pin 1 (right when looking at the front of the terminal) and - on pin 2. A reversed supply is blocked by Q8 (nothing downstream is powered; the fuse does not blow)." (exclude_from_sim no) (at 20.000 126.400 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "0a5cf602-c909-4221-bf46-796303e7869e"))
(text "Supply must be 12 V DC +/- 10% at >= 15 A (all 7 valves ON) or sequence the valves in firmware." (exclude_from_sim no) (at 20.000 130.600 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "d1cff186-953a-43a7-ae88-ef685f9ac876"))
(text "Holder body ~8 mm tall; an inserted ATO fuse stands ~20 mm above the board." (exclude_from_sim no) (at 20.000 134.800 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "ae0970ce-37fc-4fd2-af57-df77b09c7475"))
(text "If components face the L-bracket, use ~25 mm standoffs or let the holder sit past the bracket edge." (exclude_from_sim no) (at 20.000 139.000 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "a77d2f4d-bad5-48cc-b09d-ed986e8200ad"))
(text "If components face away from the bracket, no extra standoff height is needed." (exclude_from_sim no) (at 20.000 143.200 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "9eed19fa-2cb8-4b06-a703-4a255b8f2c52"))
(text "5. MOUNTING (L-BRACKET)" (exclude_from_sim no) (at 14.000 150.400 0) (effects (font (size 2.4 2.4) bold) (justify left bottom)) (uuid "251c0f22-2808-4e1a-bacb-7ba135492511"))
(text "Four M3 holes (3.2 mm NPTH) 4.0 mm from each board edge: hole centres 134.5 mm x 130.0 mm apart (sheet 8)." (exclude_from_sim no) (at 20.000 154.900 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "f5859a0e-1537-4b53-81b7-af562268080c"))
(text "Use M3 standoffs (nylon or metal) 8-10 mm tall under the bracket: the board must not touch the bracket (copper keepout 7 mm diameter around each hole)." (exclude_from_sim no) (at 20.000 159.100 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "62c2e032-cec9-439b-81bd-b861d79afa7f"))
(text "Panel wiring (E-stop, switches on DI_1..DI_8, displays J29-J31) enters from the front edge where terminals face out." (exclude_from_sim no) (at 20.000 163.300 0) (effects (font (size 1.9 1.9)) (justify left bottom)) (uuid "f8c913c4-3093-4b5b-9d2b-1ee044904aab"))
