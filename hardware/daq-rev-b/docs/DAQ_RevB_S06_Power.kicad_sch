(text_box "Input voltage" (exclude_from_sim no) (at 14.000 182.000 0) (size 44.000 4.700) (margins 0.7 0.3 0.7 0.3) (stroke (width 0.1524) (type solid)) (fill (type none)) (effects (font (size 1.8 1.8)) (justify left)) (uuid "d0c4dd70-6863-4996-a488-d457ca6869da"))
(text_box "J16 is 12 V DC only (silk: 12V IN). The R-78 accepts a wider range, but valve coils and 15 V zeners are sized for 12 V — do not feed 24 V." (exclude_from_sim no) (at 58.000 182.000 0) (size 310.000 4.700) (margins 0.7 0.3 0.7 0.3) (stroke (width 0.1524) (type solid)) (fill (type none)) (effects (font (size 1.8 1.8)) (justify left)) (uuid "54a456fb-258c-423e-b8ab-732290b4f8c8"))
